generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")

  profile           Profile?
  programs          Program[]
  nutritionPlans    NutritionPlan[]
  points            Points?
  pointTransactions PointTransaction[]
  sessionLogs       SessionLog[]
  weightHistory     WeightHistory[]

  @@map("users")
}

model Profile {
  id                  Int      @id @default(autoincrement())
  userId              Int      @unique @map("user_id")
  firstName           String?  @map("first_name")
  age                 Int
  gender              String
  heightCm            Int      @map("height_cm")
  weightKg            Decimal  @map("weight_kg") @db.Decimal(5, 2)
  goal                String
  fitnessLevel        String   @map("fitness_level")
  weeklyAvailability  Int      @map("weekly_availability")
  equipment           String
  dietaryRestrictions String[] @map("dietary_restrictions")
  bmi                 Decimal? @db.Decimal(4, 2)
  bmr                 Int?
  tdee                Int?
  updatedAt           DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Program {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  weekStart DateTime @map("week_start") @db.Date
  content   Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionLogs SessionLog[]

  @@map("programs")
}

model NutritionPlan {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  weekStart    DateTime @map("week_start") @db.Date
  content      Json
  shoppingList Json     @map("shopping_list")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("nutrition_plans")
}

model Points {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique @map("user_id")
  total     Int      @default(0)
  streak    Int      @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points")
}

model PointTransaction {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  amount    Int
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("point_transactions")
}

model SessionLog {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  programId   Int?     @map("program_id")
  sessionDate DateTime @map("session_date") @db.Date
  durationMin Int?     @map("duration_min")
  feeling     String?
  notes       String?
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id])

  @@map("session_logs")
}

model WeightHistory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  weightKg   Decimal  @map("weight_kg") @db.Decimal(5, 2)
  recordedAt DateTime @default(now()) @map("recorded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("weight_history")
}
